<view class="container">
  <view class="header">
    <view class="header-left">
      <text class="title">社交媒体下载器</text>
      <text class="subtitle">支持 Twitter / Instagram / TikTok</text>
    </view>
    <view class="header-right" bindtap="goToHistory">
      <text class="history-btn">历史</text>
    </view>
  </view>

  <view class="input-section">
    <input
      class="url-input"
      placeholder="粘贴分享链接..."
      bindinput="onUrlChange"
      value="{{url}}"
    />
    <button
      class="parse-btn"
      bindtap="onParse"
      loading="{{loading}}"
      disabled="{{btnDisabled}}"
    >
      解析
    </button>
  </view>

  <view class="media-list" wx:if="{{mediaList.length > 0}}">
    <block wx:for="{{mediaList}}" wx:key="id">
      <view class="media-item">
        <image
          src="{{item.thumbnailUrl}}"
          mode="aspectFill"
          class="media-thumb"
          binderror="onImageError"
          data-media-id="{{item.id}}"
        />
        <view class="media-info">
          <text class="media-type">{{item.type === 'video' ? '视频' : '图片'}}</text>
          <text class="media-resolution" wx:if="{{item.resolution}}">{{item.resolution}}</text>
          <view wx:if="{{item.resolutions}}" class="resolution-selector">
            <button
              wx:for="{{item.resolutions}}"
              wx:for-item="res"
              wx:key="id"
              size="mini"
              type="{{selectedResolutions[item.id] === res.id ? 'primary' : 'default'}}"
              bindtap="onSelectResolution"
              data-media-id="{{item.id}}"
              data-res-id="{{res.id}}"
            >
              {{res.label}}{{res.size ? ' (' + res.size + ')' : ''}}
            </button>
            <button
              wx:if="{{item.downloadUrl}}"
              type="primary"
              size="mini"
              bindtap="onSave"
              data-url="{{item.downloadUrl}}"
              data-media-id="{{item.id}}"
            >
              保存到相册
            </button>
          </view>
          <button
            wx:if="{{!item.resolutions && item.downloadUrl}}"
            type="primary"
            size="mini"
            bindtap="onSave"
            data-url="{{item.downloadUrl}}"
            data-media-id="{{item.id}}"
          >
            保存到相册
          </button>
        </view>
      </view>
    </block>
  </view>
</view>
