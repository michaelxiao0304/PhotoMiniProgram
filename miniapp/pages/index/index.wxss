.container {
  padding: 32rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 48rpx;
}

.header-left {
  flex: 1;
}

.header-right {
  padding-top: 8rpx;
}

.history-btn {
  font-size: 28rpx;
  color: #07c160;
  padding: 8rpx 20rpx;
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.url-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 60rpx 0 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.input-wrapper {
  position: relative;
  width: 100%;
}

.clear-btn {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.parse-btn {
  width: 100%;
  background-color: #07c160;
  color: #fff;
}

.media-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.media-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 400rpx;
}

.media-info {
  padding: 24rpx;
}

.media-title {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.copy-btn {
  font-size: 24rpx;
  color: #07c160;
  padding: 4rpx 16rpx;
  border: 1rpx solid #07c160;
  border-radius: 8rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.media-type {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.media-resolution {
  font-size: 24rpx;
  color: #999;
}

.resolution-selector {
  margin-top: 16rpx;
}

.resolution-selector button {
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1000;
}

.modal-content {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
