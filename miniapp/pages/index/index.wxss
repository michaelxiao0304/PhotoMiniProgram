.container {
  padding: 32rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.input-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}

.url-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.parse-btn {
  width: 100%;
  background-color: #07c160;
  color: #fff;
}

.media-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.media-item {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.media-thumb {
  width: 100%;
  height: 400rpx;
}

.media-info {
  padding: 24rpx;
}

.media-type {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.media-resolution {
  font-size: 24rpx;
  color: #999;
}

.resolution-selector {
  margin-top: 16rpx;
}

.resolution-selector button {
  margin-right: 16rpx;
  margin-bottom: 8rpx;
}
