/* history.wxss */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 30rpx;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.clear-btn {
  font-size: 28rpx;
  color: #ff6b6b;
}

.loading, .empty {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 100rpx;
  color: #999;
  font-size: 28rpx;
}

.history-list {
  padding: 20rpx;
}

.history-item {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.platform {
  font-size: 24rpx;
  color: #666;
  background-color: #f0f0f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.item-content {
  margin-bottom: 16rpx;
}

.item-content .title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.url {
  font-size: 26rpx;
  color: #333;
  word-break: break-all;
  line-height: 1.5;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.media-count {
  font-size: 24rpx;
  color: #999;
}

.actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  font-size: 26rpx;
  padding: 8rpx 24rpx;
  border-radius: 8rpx;
}

.action-btn.copy {
  color: #666;
  background-color: #f5f5f5;
}

.action-btn.use {
  color: #fff;
  background-color: #07c160;
}

/* Download Tasks Styles */
.section {
  background-color: #fff;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 30rpx;
  border-bottom: 1rpx solid #eee;
  background-color: #fff;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.expand-icon {
  font-size: 24rpx;
  color: #999;
  margin-right: 12rpx;
  transition: transform 0.2s;
}

.expand-icon.expanded {
  transform: rotate(90deg);
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-count {
  font-size: 28rpx;
  color: #999;
  margin-left: 8rpx;
}

.clear-all-btn {
  font-size: 26rpx;
  color: #ff6b6b;
}

.task-list {
  padding: 20rpx;
  max-height: 50vh;
}

.task-item {
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.task-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.task-type {
  font-size: 22rpx;
  color: #fff;
  background-color: #07c160;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}

.task-status {
  font-size: 24rpx;
  font-weight: 500;
}

.task-status.resolving,
.task-status.downloading,
.task-status.saving {
  color: #faad14;
}

.task-status.completed {
  color: #07c160;
}

.task-status.failed {
  color: #ff4d4f;
}

.task-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-url {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-progress {
  margin: 16rpx 0;
}

.task-progress progress {
  width: 100%;
  border-radius: 4rpx;
}

.progress-text {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-top: 8rpx;
  text-align: center;
}

.task-error {
  margin: 12rpx 0;
  padding: 12rpx;
  background-color: #fff2f0;
  border-radius: 8rpx;
}

.task-error text {
  font-size: 24rpx;
  color: #ff4d4f;
}

.task-completed {
  margin: 12rpx 0;
  padding: 12rpx;
  background-color: #f6ffed;
  border-radius: 8rpx;
}

.task-completed text {
  font-size: 24rpx;
  color: #07c160;
}

.task-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.task-time {
  font-size: 22rpx;
  color: #999;
}

.task-actions {
  display: flex;
  gap: 16rpx;
}

.task-btn {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.task-btn.retry {
  color: #fff;
  background-color: #07c160;
}

.task-btn.remove {
  color: #666;
  background-color: #f0f0f0;
}
