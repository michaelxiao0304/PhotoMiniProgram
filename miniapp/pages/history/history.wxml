<!--history.wxml-->
<view class="container">
  <view class="header">
    <text class="title">任务列表</text>
  </view>

  <view class="loading" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>

  <!-- Download Tasks Section -->
  <view class="section" wx:if="{{hasDownloadTasks || downloadTasks.length > 0}}">
    <view class="section-header" bindtap="toggleTasks">
      <view class="section-title-row">
        <text class="expand-icon {{tasksExpanded ? 'expanded' : ''}}">▶</text>
        <text class="section-title">下载任务</text>
        <text class="section-count">({{downloadTasks.length}})</text>
      </view>
      <text class="clear-all-btn" catchtap="onClearAllTasks">清空</text>
    </view>

    <scroll-view scroll-y="true" class="task-list" wx:if="{{tasksExpanded}}">
      <block wx:for="{{downloadTasks}}" wx:key="id">
        <view class="task-item">
          <view class="task-header">
            <text class="task-type">{{item.mediaType}}</text>
            <text class="task-status {{item.status}}">{{item.status === 'completed' ? '已完成' : item.status === 'failed' ? '失败' : item.status === 'saving' ? '保存中' : item.status === 'downloading' ? '下载中' : item.status === 'resolving' ? '获取链接' : item.status}}</text>
          </view>
          <view class="task-title" wx:if="{{item.title}}">{{item.title}}</view>
          <view class="task-url" wx:if="{{!item.title}}">{{item.url}}</view>

          <!-- Progress bar for downloading status -->
          <view class="task-progress" wx:if="{{item.status === 'downloading' || item.status === 'resolving'}}">
            <progress percent="{{item.progressPercent}}" stroke-width="6" backgroundColor="#e0e0e0" activeColor="#07c160" />
            <text class="progress-text">{{item.progress}}</text>
          </view>

          <!-- Error message for failed status -->
          <view class="task-error" wx:if="{{item.status === 'failed'}}">
            <text>{{item.error}}</text>
          </view>

          <!-- Completed message -->
          <view class="task-completed" wx:if="{{item.status === 'completed'}}">
            <text>已完成</text>
          </view>

          <view class="task-footer">
            <text class="task-time">{{item.createdAt}}</text>
            <view class="task-actions">
              <text class="task-btn retry" wx:if="{{item.status === 'failed'}}" catchtap="onRetryDownload" data-task-id="{{item.id}}">重试</text>
              <text class="task-btn remove" catchtap="onClearTask" data-task-id="{{item.id}}">移除</text>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>

  <!-- History Section -->
  <view class="section">
    <view class="section-header" bindtap="toggleHistory">
      <view class="section-title-row">
        <text class="expand-icon {{historyExpanded ? 'expanded' : ''}}">▶</text>
        <text class="section-title">历史记录</text>
        <text class="section-count">({{historyList.length}})</text>
      </view>
      <text class="clear-all-btn" catchtap="onClearHistory" wx:if="{{historyList.length > 0}}">清空</text>
    </view>

    <scroll-view scroll-y="true" class="history-list" wx:if="{{historyExpanded}}">
      <view class="empty" wx:if="{{historyList.length === 0}}">
        <text>暂无历史记录</text>
      </view>
      <block wx:for="{{historyList}}" wx:key="id">
        <view class="history-item">
          <view class="item-header">
            <text class="platform">{{item.platform}}</text>
            <text class="time">{{item.timestamp}}</text>
          </view>
          <view class="item-content" wx:if="{{item.title}}">
            <text class="title">{{item.title}}</text>
          </view>
          <view class="item-content">
            <text class="url" selectable="true">{{item.url}}</text>
          </view>
          <view class="item-footer">
            <text class="media-count">{{item.mediaCount || 1}} 个媒体</text>
            <view class="actions">
              <text class="action-btn copy" catchtap="onCopyUrl" data-url="{{item.url}}">复制</text>
              <text class="action-btn use" catchtap="onUseUrl" data-url="{{item.url}}">使用</text>
            </view>
          </view>
        </view>
      </block>
    </scroll-view>
  </view>
</view>
